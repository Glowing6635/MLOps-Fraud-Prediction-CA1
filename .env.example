# Copy this file to .env (git-ignored) and fill in the values.
# Variables already set in the environment override .env.

# RDS MySQL
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# MLflow server and its login
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=
# The server has no login until issue #9 adds one, so put any placeholder, such
# as none, in both; the server ignores them until then.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
